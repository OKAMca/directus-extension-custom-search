{
  "name": "directus-extension-custom-search-okam",
  "description": "Override the Directus internal search system with a custom search filter - supports relationships. Fork of github:cmiteam/directus-extension-custom-search",
  "icon": "extension",
  "version": "0.1.0",
  "license": "MIT",
  "contributors": [
    {
      "name": "Creation Ministries International - IT Team",
      "url": "https://creation.com"
    }
  ],
  "repository": {
    "type": "git",
    "url": "github:OKAMca/directus-extension-custom-search"
  },
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "bundle",
    "sandbox": {
      "enabled": true,
      "requestedScopes": {}
    },
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "hook",
        "name": "intercept-search",
        "source": "src/intercept-search/index.ts"
      },
      {
        "type": "interface",
        "name": "search-configuration",
        "source": "src/search-configuration/index.ts"
      }
    ],
    "host": "^10.10.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "add": "directus-extension add"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.1.4",
    "@types/node": "^20.12.13",
    "typescript": "^5.4.5",
    "vue": "^3.4.27"
  },
  "packageManager": "pnpm@9.12.0+sha512.4abf725084d7bcbafbd728bfc7bee61f2f791f977fd87542b3579dcb23504d170d46337945e4c66485cd12d588a0c0e570ed9c477e7ccdd8507cf05f3f92eaca",
  "pnpm": {
    "overrides": {
      "@unhead/vue": "2.1.17",
      "axios": "1.21.0",
      "deepmerge": "npm:@shivammathur/deepmerge@4.3.2",
      "joi": "18.3.1",
      "js-yaml": "4.3.2",
      "nanoid@5": "5.1.16",
      "vite": "8.3.5",
      "vue": "^3.5.45",
      "zod": "4.6.7"
    }
  }
}
